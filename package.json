{
  "name": "dsh-peak-idle-status",
  "version": "0.1.0",
  "description": "DSH 北京时间高峰/空闲实时状态，周末及中国节假日全天空闲",
  "type": "module",
  "license": "MIT",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "status.cjs",
    "2026.json",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "test-status.cjs"
  ],
  "scripts": {
    "build": "node build.cjs",
    "test": "node --test test-status.cjs"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "peak-hours"
  ],
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sfgasg/dsh-peak-idle-status.git"
  },
  "homepage": "https://github.com/sfgasg/dsh-peak-idle-status#readme",
  "bugs": {
    "url": "https://github.com/sfgasg/dsh-peak-idle-status/issues"
  }
}
